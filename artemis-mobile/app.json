{
  "expo": {
    "name": "artemis-mobile",
    "slug": "artemis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.artemis.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Ártemis necesita acceso a tus fotos para elegir la portada de tus recetas y tu foto de perfil."
      }
    },
    "android": {
      "package": "com.artemis.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Ártemis necesita acceso a tus fotos para elegir la portada de tus recetas y tu foto de perfil."
        }
      ]
    ]
  }
}
